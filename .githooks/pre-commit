#!/bin/sh
# 提交前检查：文档一致性 + 代码改动是否伴随 DEVLOG 更新。
#
# 由 scripts/check_docs.py 实现全部逻辑，本文件只负责调用。
# 需要临时跳过：SKIP_DOC_CHECK=1 git commit ...（并在提交信息里说明理由）
#
# 解释器优先用项目虚拟环境——依赖装在 .venv 里，全局 python 很可能没有 jsonschema，
# 那样检查会失败并挡住提交。找不到任何解释器时才放过，避免环境问题卡死。
if [ -x ".venv/Scripts/python.exe" ]; then
  PY=".venv/Scripts/python.exe"        # Windows
elif [ -x ".venv/bin/python" ]; then
  PY=".venv/bin/python"                # Linux / macOS
elif command -v python >/dev/null 2>&1; then
  PY=python
elif command -v py >/dev/null 2>&1; then
  PY=py
else
  echo "[pre-commit] 未找到 python，跳过文档一致性检查"
  exit 0
fi

"$PY" scripts/check_docs.py --staged
